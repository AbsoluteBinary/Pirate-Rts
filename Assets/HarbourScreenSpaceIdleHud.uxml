    <ui:VisualElement name="HUD" style="flex-grow: 1;">
        <ui:VisualElement name="TopPanel" class="DropDownStyleSheet" style="flex-grow: 1; flex-direction: row; height: 100%; width: 85%; max-height: 10%; justify-content: flex-start; align-self: auto; align-content: auto; align-items: auto; background-color: rgba(0, 191, 255, 0.3);">
            <ui:Button text="Button" name="WorldMapLoadButton" style="align-items: auto; align-content: auto; -unity-text-align: middle-center; white-space: pre; padding-left: 12px; margin-top: 1px; margin-bottom: 1px; min-width: 10%; min-height: 5%; align-self: center;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="OptionsPanel" class="DropDownStyleSheet" style="flex-grow: 1; align-self: flex-start; justify-content: space-evenly; align-items: flex-start; align-content: flex-start;">
        <ui:DropdownField label="Options" name="OptionsMenu" choices="Button 1,Button 2,Button 3" style="width: 313px; height: 41px;"/>
    </ui:VisualElement>
