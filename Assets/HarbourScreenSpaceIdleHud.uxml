<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/DropDownStyleSheet.uss?fileID=7433441132597879392&amp;guid=619b4fdff27291e64957fafe16f2a774&amp;type=3"/>
